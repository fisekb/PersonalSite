{
  "info": {
    "name": "Fistum Portfolio API",
    "description": "Collection for the portfolio website admin API and public service request flow.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Health Check",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "http://localhost:5000/api/v1/health",
          "protocol": "http",
          "host": ["localhost"],
          "port": "5000",
          "path": ["api", "v1", "health"]
        }
      }
    },
    {
      "name": "Admin Login",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"admin@example.com\",\n  \"password\": \"replace-with-your-admin-password\"\n}"
        },
        "url": {
          "raw": "http://localhost:5000/api/v1/auth/login",
          "protocol": "http",
          "host": ["localhost"],
          "port": "5000",
          "path": ["api", "v1", "auth", "login"]
        }
      }
    },
    {
      "name": "Get Current User",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": {
          "raw": "http://localhost:5000/api/v1/auth/me",
          "protocol": "http",
          "host": ["localhost"],
          "port": "5000",
          "path": ["api", "v1", "auth", "me"]
        }
      }
    },
    {
      "name": "List Projects",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "http://localhost:5000/api/v1/projects?page=1&limit=10",
          "protocol": "http",
          "host": ["localhost"],
          "port": "5000",
          "path": ["api", "v1", "projects"],
          "query": [
            { "key": "page", "value": "1" },
            { "key": "limit", "value": "10" }
          ]
        }
      }
    },
    {
      "name": "Get Project by Slug",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "http://localhost:5000/api/v1/projects/api-platform",
          "protocol": "http",
          "host": ["localhost"],
          "port": "5000",
          "path": ["api", "v1", "projects", "api-platform"]
        }
      }
    },
    {
      "name": "Create Project",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "body": {
          "mode": "formdata",
          "formdata": [
            { "key": "title", "value": "API Platform" },
            { "key": "description", "value": "Modern backend platform" },
            { "key": "longDescription", "value": "A production-ready platform for managing operations and analytics." },
            { "key": "featured", "value": "true" },
            { "key": "displayOrder", "value": "1" },
            { "key": "liveUrl", "value": "https://example.com" },
            { "key": "repoUrl", "value": "https://github.com/example/api-platform" },
            { "key": "techStack", "value": "Node.js" },
            { "key": "techStack", "value": "PostgreSQL" },
            { "key": "techStack", "value": "Express" },
            { "key": "image", "type": "file", "src": "" }
          ]
        },
        "url": {
          "raw": "http://localhost:5000/api/v1/projects",
          "protocol": "http",
          "host": ["localhost"],
          "port": "5000",
          "path": ["api", "v1", "projects"]
        }
      }
    },
    {
      "name": "Update Project",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "body": {
          "mode": "formdata",
          "formdata": [
            { "key": "title", "value": "Updated API Platform" },
            { "key": "description", "value": "Updated backend platform" },
            { "key": "longDescription", "value": "An updated project description for the dashboard demo." },
            { "key": "featured", "value": "true" },
            { "key": "displayOrder", "value": "2" },
            { "key": "liveUrl", "value": "https://updated-example.com" },
            { "key": "repoUrl", "value": "https://github.com/example/updated-api-platform" },
            { "key": "techStack", "value": "Node.js" },
            { "key": "techStack", "value": "Express" },
            { "key": "techStack", "value": "React" },
            { "key": "image", "type": "file", "src": "" }
          ]
        },
        "url": {
          "raw": "http://localhost:5000/api/v1/projects/:id",
          "protocol": "http",
          "host": ["localhost"],
          "port": "5000",
          "path": ["api", "v1", "projects", ":id"]
        }
      }
    },
    {
      "name": "Delete Project",
      "request": {
        "method": "DELETE",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": {
          "raw": "http://localhost:5000/api/v1/projects/:id",
          "protocol": "http",
          "host": ["localhost"],
          "port": "5000",
          "path": ["api", "v1", "projects", ":id"]
        }
      }
    },
    {
      "name": "Create Service Request",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Jane Doe\",\n  \"email\": \"jane@example.com\",\n  \"phone\": \"+123456789\",\n  \"serviceType\": \"Website Development\",\n  \"budgetRange\": \"$2k - $5k\",\n  \"message\": \"I want to build a custom portfolio site.\"\n}"
        },
        "url": {
          "raw": "http://localhost:5000/api/v1/service-requests",
          "protocol": "http",
          "host": ["localhost"],
          "port": "5000",
          "path": ["api", "v1", "service-requests"]
        }
      }
    },
    {
      "name": "List Service Requests",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": {
          "raw": "http://localhost:5000/api/v1/service-requests?page=1&limit=10",
          "protocol": "http",
          "host": ["localhost"],
          "port": "5000",
          "path": ["api", "v1", "service-requests"],
          "query": [
            { "key": "page", "value": "1" },
            { "key": "limit", "value": "10" }
          ]
        }
      }
    },
    {
      "name": "Get Service Request Stats",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": {
          "raw": "http://localhost:5000/api/v1/service-requests/stats",
          "protocol": "http",
          "host": ["localhost"],
          "port": "5000",
          "path": ["api", "v1", "service-requests", "stats"]
        }
      }
    },
    {
      "name": "Update Request Status",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"status\": \"in-review\"\n}"
        },
        "url": {
          "raw": "http://localhost:5000/api/v1/service-requests/:id/status",
          "protocol": "http",
          "host": ["localhost"],
          "port": "5000",
          "path": ["api", "v1", "service-requests", ":id", "status"]
        }
      }
    },
    {
      "name": "Delete Service Request",
      "request": {
        "method": "DELETE",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": {
          "raw": "http://localhost:5000/api/v1/service-requests/:id",
          "protocol": "http",
          "host": ["localhost"],
          "port": "5000",
          "path": ["api", "v1", "service-requests", ":id"]
        }
      }
    }
  ],
  "variable": [
    {
      "key": "token",
      "value": "paste-your-jwt-token-here"
    }
  ]
}
